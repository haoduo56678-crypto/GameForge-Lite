{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "feature/**": false,
      "fix/**": false,
      "audit/**": false,
      "chore/**": false,
      "docs/**": false
    }
  }
}
